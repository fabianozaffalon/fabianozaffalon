generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Marca {
  id          String   @id @default(cuid())
  name        String
  logo        String
  catalogoPdf String?
  unidades    String[]
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Noticia {
  id          String   @id @default(cuid())
  slug        String   @unique
  categoria   String
  titulo      String
  resumo      String
  conteudo    String   @db.Text
  capa        String
  fotos       String[]
  publicada   Boolean  @default(true)
  publishedAt DateTime @default(now())
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Case {
  id        String   @id @default(cuid())
  slug      String   @unique
  tag       String   @default("Case de Crescimento")
  titulo    String
  subtitulo String?
  conteudo  String   @db.Text
  capa      String
  galeria   String[]
  ordem     Int      @default(0)
  data      String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Oferta {
  id        String    @id @default(cuid())
  titulo    String
  imagem    String
  link      String?
  ordem     Int       @default(0)
  ativo     Boolean   @default(true)
  validade  DateTime?           // null = sem validade definida (sempre visível)
  createdAt DateTime  @default(now())
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(EDITOR)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum Role {
  OWNER
  ADMIN
  EDITOR
}