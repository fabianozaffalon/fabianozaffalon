# Google Tag Manager (preferência)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 (se não usar GTM)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Instagram / Facebook Graph API — ver comentário em src/app/api/cron/jobs/route.ts
# (fluxo correto: User Token de longa duração → deriva Page Access Token, nunca
# usar o token direto do Graph API Explorer em produção)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=101521062281980
INSTAGRAM_BUSINESS_ID=17841449196602517
# Semente: User Access Token de longa duração (permissões pages_show_list,
# instagram_basic, pages_read_engagement). Renovado automaticamente pelo cron.
FACEBOOK_USER_ACCESS_TOKEN=
# Page Access Token — derivado automaticamente pelo cron a partir do token acima.
INSTAGRAM_ACCESS_TOKEN=

# Renovação automática de tokens (cron em /api/cron/jobs)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
CRON_SECRET=
